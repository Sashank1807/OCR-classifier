# ==============================================================================
# AI Document Intelligence Platform - Environment Configuration Template
# Copy this file to .env and configure for your environment:
#   copy .env.example .env
# ==============================================================================

# Application Environment Configurations
APP_NAME="AI Document Intelligence Platform"
APP_ENV="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8080

# Database Settings
# MySQL (Recommended for production):
DATABASE_URL=mysql+pymysql://ocr_user:your_db_password@127.0.0.1:3306/ocr_platform?charset=utf8mb4
# SQLite (Local development fallback):
# DATABASE_URL=sqlite:///./ocr_database.db

# Model Configurations
MODEL_BACKEND="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:7b"
OLLAMA_TIMEOUT=180

# Fallback offline model path (if MODEL_BACKEND != "ollama")
MODEL_PATH="Qwen/Qwen2.5-VL-3B-Instruct"
DEVICE="auto"
LOCAL_FILES_ONLY=True

# File Processing & Storage Settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "bmp", "tiff", "webp", "pdf", "xlsx", "xls", "csv", "docx", "doc"]
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
LOG_DIR="./logs"

# Image Preprocessing Defaults
ENABLE_PREPROCESSING=True
DESKEW_ENABLED=True
CLAHE_ENABLED=True
NOISE_REMOVAL_ENABLED=True
ADAPTIVE_THRESHOLD_ENABLED=False

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET_KEY
# Comma-separated API keys (issue one per consuming department / service)
API_KEYS=CHANGE_ME_DEPARTMENT_API_KEY
# Viewer dashboard password
UI_PASSWORD=CHANGE_ME_UI_PASSWORD

MEDIA_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=43200
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10
ENABLE_DOCS=true

# Comma-separated origins for browser CORS (leave empty to deny cross-origin access)
CORS_ORIGINS=

# ==============================================================================
# Data Retention Sweeper
# ==============================================================================
# Automatically clean up temporary uploads and page renders older than N days
RETENTION_DAYS=30
RETENTION_SWEEP_HOURS=6
ENABLE_RETENTION_SWEEP=true
SAVE_DEBUG_IMAGES=false

/* ==========================================================================
   Document Intelligence - spatial glass
   --------------------------------------------------------------------------
   Implements the design system in STYLE.md. Translucent white panels float
   above a slow aurora on an almost-white canvas. The brand is LIGHT BLUE -
   white and light blue carry the whole surface - and teal / amber / rose
   are kept only to carry MEANING (success, caution, failure), never
   decoration.

   This app renders through Bootstrap 5, so the tokens below are bridged onto
   Bootstrap's own --bs-* variables. Stock markup then picks up the palette
   without every template having to be rewritten.

   LIGHT ONLY. One palette, no prefers-color-scheme block, no .dark class.
   Never write var(--x, #fallback) for a token this file does not define: the
   fallback silently wins, and that is how an input ends up near-black with
   near-black text. Add the token to :root instead.
   ========================================================================== */

:root {
    /* -- canvas and surfaces -------------------------------------------- */
    --canvas: #f4f9fe;
    --surface: rgba(255, 255, 255, .86);
    --surface-solid: #ffffff;
    --surface-soft: rgba(251, 253, 255, .82);
    --surface-sunk: rgba(234, 243, 253, .72);
    --surface-frost: rgba(255, 255, 255, .78);

    /* -- glass materials -------------------------------------------------
       Blur radius is a PERFORMANCE decision, not only a visual one: the
       cost of a backdrop-filter rises with its radius, and it is paid on
       every frame that the backdrop behind it changes. 28px over a drifting
       aurora meant the whole page recomposited while the aurora moved. 18px
       over a higher-opacity fill reads the same at a glance and costs
       roughly half.                                                        */
    --glass-bg: rgba(255, 255, 255, .80);
    --glass-bg-hover: rgba(255, 255, 255, .92);
    --glass-bg-active: rgba(255, 255, 255, .97);
    --glass-bg-sunk: rgba(233, 243, 253, .66);
    --glass-border: rgba(255, 255, 255, .88);
    --glass-border-subtle: rgba(205, 227, 246, .7);
    --glass-specular: inset 0 1px 1px rgba(255, 255, 255, .98),
                      inset 0 -1px 1px rgba(12, 74, 110, .025);
    --glass-blur: blur(18px) saturate(165%);
    --glass-blur-sm: blur(12px) saturate(150%);

    /* -- lines and ink --------------------------------------------------- */
    --line: rgba(214, 233, 248, .8);
    --line-strong: rgba(186, 214, 238, .95);
    --ink: #0b2239;
    --ink-soft: #456585;
    --ink-mute: #8aa4bd;

    /* -- brand and accents -----------------------------------------------
       Light blue is the brand. `--brand` is the one readable on white,
       `--brand-bright` is the lighter tone used for gradients and glows.   */
    --brand: #0284c7;
    --brand-deep: #0369a1;
    --brand-bright: #38bdf8;
    --brand-soft: #e8f5fe;
    --violet: #0ea5e9;
    --violet-soft: #e4f4fe;
    --teal: #0d9488;
    --teal-soft: #e6fbf7;
    --sky: #0ea5e9;
    --sky-soft: #e7f5fe;
    --amber: #d97706;
    --amber-soft: #fff5e5;
    --rose: #e11d48;
    --rose-soft: #ffeef2;

    --grad-brand: linear-gradient(135deg, #0284c7, #0ea5e9, #38bdf8);
    --grad-teal: linear-gradient(135deg, #0d9488, #0ea5e9);
    --grad-sheen: linear-gradient(115deg, transparent 20%,
                  rgba(255, 255, 255, .55) 50%, transparent 80%);

    /* -- typography ------------------------------------------------------- */
    --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    --font-mono: "JetBrains Mono", SFMono-Regular, Menlo, Monaco, Consolas,
                 "Liberation Mono", "Courier New", monospace;

    /* -- radii ------------------------------------------------------------ */
    --r-xs: 6px;
    --r-sm: 10px;
    --r-md: 14px;
    --r-lg: 20px;
    --r-xl: 26px;
    --r-pill: 9999px;

    /* -- elevation: ambient + keylight + inset white edge -------------------
       Shadows are cast in rgba(23,34,71,...), never black.                   */
    --sh-xs: 0 1px 2px rgba(12, 74, 110, .05),
             inset 0 1px 0 rgba(255, 255, 255, .7);
    --sh-sm: 0 2px 6px rgba(12, 74, 110, .06), 0 1px 2px rgba(12, 74, 110, .04),
             inset 0 1px 0 rgba(255, 255, 255, .8);
    --sh-md: 0 6px 18px rgba(12, 74, 110, .08), 0 2px 5px rgba(12, 74, 110, .05),
             inset 0 1px 0 rgba(255, 255, 255, .85);
    --sh-lg: 0 14px 34px rgba(12, 74, 110, .10), 0 4px 10px rgba(12, 74, 110, .06),
             inset 0 1px 0 rgba(255, 255, 255, .9);
    --sh-spatial-float: 0 24px 60px rgba(12, 74, 110, .13),
                        0 8px 20px rgba(12, 74, 110, .07),
                        inset 0 1px 0 rgba(255, 255, 255, .95);
    --sh-brand: 0 6px 16px rgba(2, 132, 199, .26);
    --sh-brand-lg: 0 12px 28px rgba(2, 132, 199, .32);

    /* -- motion ------------------------------------------------------------ */
    --ease: cubic-bezier(.4, 0, .2, 1);
    --spring: cubic-bezier(.16, 1, .3, 1);
    --t-fast: 140ms var(--ease);
    --t: 220ms var(--ease);
    --t-slow: 380ms var(--spring);
}

/* --------------------------------------------------------------------------
   Bootstrap bridge - map the palette onto Bootstrap's own variables so stock
   components (.btn, .card, .table, .badge, .alert) inherit it.
   -------------------------------------------------------------------------- */
:root,
[data-bs-theme="light"] {
    --bs-primary: #0284c7;
    --bs-primary-rgb: 2, 132, 199;
    --bs-link-color: #0284c7;
    --bs-link-color-rgb: 2, 132, 199;
    --bs-link-hover-color: #0369a1;

    --bs-success: #0d9488;
    --bs-success-rgb: 13, 148, 136;
    --bs-info: #0ea5e9;
    --bs-info-rgb: 14, 165, 233;
    --bs-warning: #d97706;
    --bs-warning-rgb: 217, 119, 6;
    --bs-danger: #e11d48;
    --bs-danger-rgb: 225, 29, 72;

    --bs-body-bg: var(--canvas);
    --bs-body-color: var(--ink);
    --bs-secondary-color: var(--ink-soft);
    --bs-tertiary-bg: var(--surface-sunk);
    --bs-border-color: var(--line);
    --bs-border-radius: var(--r-md);
    --bs-border-radius-sm: var(--r-sm);
    --bs-border-radius-lg: var(--r-lg);
    --bs-border-radius-xl: var(--r-xl);
    --bs-font-sans-serif: var(--font-sans);
    --bs-font-monospace: var(--font-mono);
    --bs-emphasis-color: var(--ink);
}

/* ==========================================================================
   Canvas and ambient background
   ========================================================================== */

body {
    font-family: var(--font-sans);
    background-color: var(--canvas);
    color: var(--ink);
    line-height: 1.5;
    letter-spacing: -0.011em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    position: relative;
}

/* Four radial gradients drifting behind everything, plus a masked dot grid.
   Both fixed, behind the content, never taking pointer events. */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
        radial-gradient(50rem 32rem at 12% 8%, rgba(56, 189, 248, .22), transparent 60%),
        radial-gradient(44rem 30rem at 88% 4%, rgba(2, 132, 199, .16), transparent 60%),
        radial-gradient(46rem 34rem at 78% 82%, rgba(14, 165, 233, .18), transparent 62%),
        radial-gradient(38rem 28rem at 18% 92%, rgba(125, 211, 252, .16), transparent 60%);
    /* Promoted to its own layer and animated on transform alone, so the
       drift never repaints - it only recomposites. */
    will-change: transform;
    transform: translateZ(0);
    animation: aurora 40s var(--ease) infinite alternate;
}

body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(rgba(2, 132, 199, .07) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 40%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 40%, transparent 100%);
}

@keyframes aurora {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    50%  { transform: translate3d(-1.5%, 1.5%, 0) scale(1.06); }
    100% { transform: translate3d(1.5%, -1%, 0) scale(1.03); }
}

/* ==========================================================================
   Glass recipe
   A glass surface is the FULL set: fill + backdrop-filter + border + shadow
   + specular. Dropping the specular is what makes a panel look flat beside
   the others.
   ========================================================================== */

.navbar,
.card,
.modal-content,
.dropdown-menu,
.toast {
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--sh-md), var(--glass-specular);
}

/* -- header: floats, and lifts on hover ----------------------------------- */
.navbar {
    margin: 10px 18px 0;
    border-radius: var(--r-xl);
    padding-block: .55rem;
    transition: transform var(--t), box-shadow var(--t);
    animation: dropIn 520ms var(--spring) both;
}

.navbar:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-lg), var(--glass-specular);
}

.navbar-brand {
    font-weight: 700;
    letter-spacing: -0.02em;
}

.navbar-brand span {
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.navbar-brand .bi {
    /* solid colour - gradient text would clip the glyph */
    color: var(--brand);
}

.nav-link {
    border-radius: var(--r-sm);
    padding-inline: .8rem !important;
    font-weight: 500;
    color: var(--ink-soft) !important;
    transition: color var(--t-fast), background-color var(--t-fast),
                transform var(--t-fast);
}

.nav-link:hover {
    transform: translateY(-1px);
    color: var(--brand) !important;
    background: var(--brand-soft);
}

.nav-pills .nav-link.active,
.navbar-nav .nav-link.active {
    color: var(--brand) !important;
    background: var(--brand-soft);
    box-shadow: inset 0 0 0 1px rgba(2, 132, 199, .16);
}

/* -- cards ---------------------------------------------------------------- */
.card {
    border-radius: var(--r-lg);
    transition: transform var(--t-slow), box-shadow var(--t-slow);
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-lg), var(--glass-specular) !important;
}

.card-header,
.card-footer {
    background: var(--surface-sunk);
    border-color: var(--glass-border-subtle);
}

.list-group-item {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
}

/* A stat card carries a 4px gradient rail down its left edge, scaled to 35%
   at rest and to full height on hover, and they rise in staggered 40ms apart. */
.stat-card {
    position: relative;
    overflow: hidden;
    animation: riseIn 520ms var(--spring) both;
}

.stat-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: var(--r-pill);
    background: var(--grad-brand);
    transform: scaleY(.35);
    transition: transform var(--t-slow);
}

.stat-card:hover::before { transform: scaleY(1); }

.stat-card:nth-of-type(1)::before { background: var(--grad-brand); }
.stat-card:nth-of-type(2)::before { background: var(--grad-teal); }
.stat-card:nth-of-type(3)::before { background: linear-gradient(180deg, #0d9488, #22c55e); }
.stat-card:nth-of-type(4)::before { background: linear-gradient(180deg, #f59e0b, #f97316); }
.stat-card:nth-of-type(5)::before { background: linear-gradient(180deg, #0284c7, #38bdf8); }
.stat-card:nth-of-type(6)::before { background: linear-gradient(180deg, #0ea5e9, #e11d48); }

.stat-card:nth-of-type(1) { animation-delay: 0ms; }
.stat-card:nth-of-type(2) { animation-delay: 40ms; }
.stat-card:nth-of-type(3) { animation-delay: 80ms; }
.stat-card:nth-of-type(4) { animation-delay: 120ms; }
.stat-card:nth-of-type(5) { animation-delay: 160ms; }
.stat-card:nth-of-type(6) { animation-delay: 200ms; }

/* ==========================================================================
   Controls
   ========================================================================== */

.btn {
    border-radius: var(--r-md);
    font-weight: 500;
    transition: transform var(--t-fast), box-shadow var(--t-fast),
                background-color var(--t-fast), border-color var(--t-fast);
}

.btn:hover { transform: translateY(-2px); }
.btn:active { transform: scale(.97); }

.btn-primary {
    position: relative;
    overflow: hidden;
    background: var(--grad-brand);
    border: none;
    box-shadow: var(--sh-brand);
}

.btn-primary:hover,
.btn-primary:focus,
.btn-primary:active {
    background: var(--grad-brand);
    box-shadow: var(--sh-brand-lg) !important;
}

/* the white sweep that crosses primary buttons on hover */
.btn-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--grad-sheen);
    transform: translateX(-120%);
    transition: transform 620ms var(--ease);
    pointer-events: none;
}

.btn-primary:hover::after { transform: translateX(120%); }

.btn-outline-secondary {
    color: var(--ink-soft);
    border-color: var(--line-strong);
    background: var(--surface);
}

.btn-outline-secondary:hover {
    color: var(--brand);
    border-color: var(--brand);
    background: var(--brand-soft);
}

.btn-outline-primary {
    color: var(--brand);
    border-color: var(--brand);
}

.btn-outline-primary:hover {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
}

.form-control,
.form-select {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    color: var(--ink);
    transition: border-color var(--t-fast), box-shadow var(--t-fast),
                background-color var(--t-fast);
}

.form-control:hover,
.form-select:hover { background: var(--surface-soft); }

.form-control::placeholder { color: var(--ink-mute); }

.form-control:focus,
.form-select:focus {
    background: var(--surface-solid);
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(2, 132, 199, .16);
    color: var(--ink);
}

.form-control:disabled,
.form-select:disabled {
    color: var(--ink-mute);
    background: var(--surface-sunk);
}

.input-group-text {
    background: var(--surface-sunk);
    border-color: var(--line-strong);
    color: var(--ink-soft);
}

kbd {
    font-family: var(--font-mono);
    background: var(--surface-sunk);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-xs);
    color: var(--ink-soft);
}

/* -- drop zone ------------------------------------------------------------- */
.drop-zone {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border-radius: var(--r-lg);
    background: var(--glass-bg-sunk);
    border: 2px dashed var(--line-strong) !important;
    transition: transform var(--t-slow), border-color var(--t),
                background-color var(--t), box-shadow var(--t);
}

.drop-zone::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--grad-sheen);
    transform: translateX(-120%);
    transition: transform 700ms var(--ease);
    pointer-events: none;
}

.drop-zone:hover::after,
.drop-zone.drag-over::after { transform: translateX(120%); }

.drop-zone:hover,
.drop-zone.drag-over {
    border-color: var(--brand) !important;
    background: var(--brand-soft) !important;
    transform: scale(1.01);
    box-shadow: var(--sh-md), var(--glass-specular);
}

/* ==========================================================================
   Colour that carries meaning
   Teal = confirmed, sky = deterministic, amber = unsaved or uncertain,
   rose = failed, grey = unchecked. Do not spend these on decoration, and
   never let colour be the only signal - print the word too.
   ========================================================================== */

.badge {
    border-radius: var(--r-pill);
    font-weight: 600;
    letter-spacing: .01em;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
}

.badge:hover { transform: scale(1.05); }

.status-exact,
.text-bg-info-subtle    { background: var(--sky-soft) !important;    color: #0369a1 !important; }
.status-verified,
.text-bg-success-subtle { background: var(--teal-soft) !important;   color: #0f766e !important; }
.status-corrected {
    background: var(--teal-soft) !important;
    color: #0f766e !important;
    box-shadow: inset 0 0 0 1px rgba(13, 148, 136, .45);
}
.status-unchecked,
.status-unchecked_text  { background: var(--surface-sunk) !important; color: var(--ink-soft) !important; }
.status-flagged,
.text-bg-danger-subtle  { background: var(--rose-soft) !important;   color: #be123c !important; }
.text-bg-warning-subtle { background: var(--amber-soft) !important;  color: #92400e !important; }
.text-bg-primary-subtle { background: var(--brand-soft) !important;  color: var(--brand-deep) !important; }
.text-bg-secondary-subtle { background: var(--surface-sunk) !important; color: var(--ink-soft) !important; }

.text-success { color: #0f766e !important; }
.text-danger  { color: #be123c !important; }
.text-warning { color: #92400e !important; }
.text-info    { color: #0369a1 !important; }
.text-primary { color: var(--brand) !important; }

/* Confidence. Thresholds live in JS, not here:
   score < 70 -> low (rose) | 70-89 -> medium (amber) | >= 90 -> high (teal).
   Medium is also the default when the score is null. */
.conf-low  { background: var(--rose-soft)  !important; color: #be123c !important; }
.conf-med  { background: var(--amber-soft) !important; color: #92400e !important; }
.conf-high { background: var(--teal-soft)  !important; color: #0f766e !important; }

/* Bounding boxes over a page image. Strokes stay one width at every zoom. */
.bbox-polygon {
    fill: rgba(2, 132, 199, .12);
    stroke: var(--brand);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transition: fill var(--t-fast), stroke var(--t-fast);
}

.bbox-polygon:hover,
.bbox-polygon.highlighted {
    fill: rgba(13, 148, 136, .32);
    stroke: var(--teal);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px rgba(13, 148, 136, .5));
}

.bbox-polygon.conf-warn { fill: rgba(217, 119, 6, .14); stroke: var(--amber); }
.bbox-polygon.conf-bad  { fill: rgba(225, 29, 72, .16); stroke: var(--rose); }

/* Unsaved work is amber. */
.is-edited {
    background: var(--amber-soft) !important;
    border-color: var(--amber) !important;
    color: #92400e !important;
}

/* JSON syntax highlighting. Match the raw text FIRST, escape afterwards -
   escaping first leaves no quote for the string rule to find, and the number
   rule then colours digits inside HTML entities. */
.json-key     { color: #0369a1; font-weight: 600; }
.json-string  { color: #0f766e; }
.json-number  { color: #b45309; }
.json-boolean { color: #be185d; font-weight: 600; }
.json-null    { color: var(--ink-mute); font-style: italic; }

/* A search hit is a highlighter stroke, not a block fill, so the text
   underneath stays fully legible. */
mark,
mark.hit {
    background: linear-gradient(180deg, transparent 55%, rgba(250, 204, 21, .65) 55%);
    color: inherit;
    padding: 0;
}

/* -- feedback surfaces ----------------------------------------------------- */
.alert { border-radius: var(--r-md); box-shadow: var(--sh-xs); }
.alert-info    { background: var(--sky-soft);   border-color: rgba(2, 132, 199, .22);  color: #075985; }
.alert-success { background: var(--teal-soft);  border-color: rgba(13, 148, 136, .22); color: #0b6d64; }
.alert-warning { background: var(--amber-soft); border-color: rgba(217, 119, 6, .24);  color: #92400e; }
.alert-danger  { background: var(--rose-soft);  border-color: rgba(225, 29, 72, .26);  color: #9f1239;
                 animation: shake 420ms var(--ease) both; }

.toast { border-radius: var(--r-md); }
.toast.text-bg-success {
    background: var(--teal-soft) !important;
    color: #0b6d64 !important;
    border-left: 3px solid var(--teal) !important;
}
.toast.text-bg-danger {
    background: var(--rose-soft) !important;
    color: #9f1239 !important;
    border-left: 3px solid var(--rose) !important;
}
.toast .btn-close-white { filter: none; }

.progress {
    background: var(--surface-sunk);
    border-radius: var(--r-pill);
    height: .5rem;
}

.progress-bar { background: var(--grad-brand); }

/* ==========================================================================
   Tables
   ========================================================================== */

.table {
    --bs-table-bg: transparent;
    --bs-table-color: var(--ink);
    border-color: var(--line);
}

.table > thead th {
    background: var(--surface-sunk);
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    border-bottom: 1px solid var(--line-strong);
}

.table tbody tr {
    transition: background-color var(--t-fast), transform var(--t-fast);
    animation: rowIn 320ms var(--ease) both;
}

.table tbody tr:hover {
    background-color: rgba(2, 132, 199, .05) !important;
    transform: scale(1.002);
}

/* ==========================================================================
   Reader panes
   ========================================================================== */

/* Monospace for anything compared character by character. */
.style-pre-wrap {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink);
}

.style-preview-img {
    max-height: 680px;
    object-fit: contain;
    border-radius: var(--r-md);
    transition: transform var(--t-slow), box-shadow var(--t-slow);
    animation: imageIn 520ms var(--spring) both;
}

.style-preview-img:hover {
    transform: scale(1.015);
    box-shadow: var(--sh-lg) !important;
}

.nav-tabs {
    border-bottom-color: var(--line);
    gap: .25rem;
}

.nav-tabs .nav-link {
    border: none;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
}

.nav-tabs .nav-link.active {
    background: var(--surface-solid);
    color: var(--brand) !important;
    box-shadow: inset 0 -2px 0 var(--brand);
}

/* The tab group and the action group must stay visibly separate - a divider
   between "what is on screen" and "what is exported". */
.action-divider {
    width: 1px;
    align-self: stretch;
    margin-inline: .35rem;
    background: var(--line-strong);
}

/* ==========================================================================
   Motion
   Hover lifts with a larger shadow; active presses to scale(.92-.97);
   entrances use --spring, state changes use --ease.
   ========================================================================== */

@keyframes dropIn  { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
@keyframes riseIn  { from { opacity: 0; transform: translateY(14px); }  to { opacity: 1; transform: none; } }
@keyframes paneIn  { from { opacity: 0; transform: translateY(10px) scale(.995); } to { opacity: 1; transform: none; } }
@keyframes popIn   { from { opacity: 0; transform: scale(.9); }         to { opacity: 1; transform: none; } }
@keyframes rowIn   { from { opacity: 0; transform: translateY(4px); }   to { opacity: 1; transform: none; } }
@keyframes imageIn { from { opacity: 0; transform: scale(.985); }       to { opacity: 1; transform: none; } }
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(5px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(2px); }
}
@keyframes pulseRing {
    0%   { box-shadow: 0 0 0 0 rgba(13, 148, 136, .5); }
    70%  { box-shadow: 0 0 0 8px rgba(13, 148, 136, 0); }
    100% { box-shadow: 0 0 0 0 rgba(13, 148, 136, 0); }
}
@keyframes shimmer { from { background-position: -420px 0; } to { background-position: 420px 0; } }

main > * { animation: paneIn 420ms var(--spring) both; }

.pulse-dot {
    display: inline-block;
    width: .5rem;
    height: .5rem;
    border-radius: var(--r-pill);
    background: var(--teal);
    animation: pulseRing 2s var(--ease) infinite;
}

.skeleton {
    background: linear-gradient(90deg, var(--surface-sunk) 25%,
                rgba(255, 255, 255, .7) 50%, var(--surface-sunk) 75%);
    background-size: 840px 100%;
    animation: shimmer 1.4s linear infinite;
    border-radius: var(--r-sm);
}

/* ==========================================================================
   Focus and accessibility
   Every status is carried by text as well as colour, so the taxonomy survives
   a colour-blind reader and a greyscale print.
   ========================================================================== */

:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, .30);
    border-radius: var(--r-sm);
}

.btn:focus-visible {
    box-shadow: 0 0 0 3px rgba(2, 132, 199, .30), var(--sh-sm);
}

/* Motion is decoration here - nothing is conveyed by animation alone. */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
        scroll-behavior: auto !important;
    }
    body::before { animation: none; }
}

/* ==========================================================================
   Chrome
   ========================================================================== */

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
    background: rgba(198, 207, 226, .7);
    border-radius: var(--r-pill);
}
::-webkit-scrollbar-thumb:hover { background: rgba(198, 207, 226, .9); }
* { scrollbar-width: thin; scrollbar-color: rgba(198, 207, 226, .7) transparent; }

::selection { background: rgba(14, 165, 233, .2); }

footer {
    background: transparent !important;
    border-top: 1px solid var(--line) !important;
    color: var(--ink-mute);
}

.text-body-secondary { color: var(--ink-soft) !important; }
.text-muted { color: var(--ink-mute) !important; }
.border { border-color: var(--line) !important; }
.bg-body,
.bg-body-tertiary { background: transparent !important; }
.shadow-sm { box-shadow: var(--sh-sm) !important; }
.shadow { box-shadow: var(--sh-md) !important; }
.shadow-lg { box-shadow: var(--sh-lg) !important; }

/* ==========================================================================
   Breakpoints
   ========================================================================== */

@media (max-width: 1280px) {
    .stats-bar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 1180px) {
    .pane-header { flex-wrap: wrap; }
    .pane-header .action-group { width: 100%; margin-top: .5rem; }
}

@media (max-width: 1024px) {
    .navbar { margin: 8px 10px 0; }
    .stats-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* ==========================================================================
   Motion quality - "butter smooth" is mostly about what you DON'T animate
   --------------------------------------------------------------------------
   A transition is smooth when the browser can serve every frame from the
   compositor. Only `transform`, `opacity` and `filter` qualify. Animating
   `box-shadow`, `background`, `backdrop-filter`, `width` or `top` forces a
   paint - and over a backdrop-filtered panel, a paint of everything behind
   it too, which is where dropped frames come from on a page built out of
   glass.

   So the elevation change on hover is done by cross-fading a PSEUDO-ELEMENT
   that holds the deeper shadow, rather than by animating box-shadow itself.
   The look is identical; the cost is not.
   ========================================================================== */

.card,
.navbar,
.btn,
.dropdown-menu,
.toast,
.list-group-item,
.nav-link {
    /* One timing function everywhere, so nothing feels out of step. */
    transition-timing-function: var(--spring);
}

/* The lift. Transform + opacity only. */
.card.is-liftable,
.lift {
    position: relative;
    transition: transform var(--t) var(--spring);
}

.card.is-liftable::after,
.lift::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--sh-spatial-float);
    opacity: 0;
    transition: opacity var(--t) var(--spring);
    pointer-events: none;
    z-index: -1;
}

.card.is-liftable:hover,
.lift:hover { transform: translate3d(0, -3px, 0); }
.card.is-liftable:hover::after,
.lift:hover::after { opacity: 1; }

/* Press feedback: instant down, eased back. Anything slower than ~90ms on
   the way down reads as lag rather than as a button. */
.btn:active { transform: translate3d(0, 1px, 0) scale(.985); transition-duration: 90ms; }

/* --------------------------------------------------------------------------
   Layer promotion, used sparingly.

   `will-change` is a budget, not a hint to sprinkle: every promoted element
   is a texture held in GPU memory. It is set only on things that actually
   animate, and dropped again once they are idle where possible.
   -------------------------------------------------------------------------- */
.navbar,
.modal.show .modal-content,
.toast.showing {
    will-change: transform;
}

/* Glass panels paint their own subtree only - stops a hover inside one card
   invalidating the layout of its neighbours. */
.card,
.modal-content,
.dropdown-menu {
    contain: paint;
}

/* Backdrop-filter is the single most expensive declaration on the page, so
   it is spent on large surfaces and withheld from small repeated ones.
   Badges, table rows and list items get a translucent fill instead - at
   thumbnail size nobody can tell, and a table of forty blurred rows is
   forty backdrop samples per frame. */
.badge,
.list-group-item,
.table tbody tr {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
}

/* Honour the OS setting properly: kill decorative motion, but keep the
   state change instant rather than merely fast, and drop the GPU layers. */
@media (prefers-reduced-motion: reduce) {
    .card.is-liftable:hover,
    .lift:hover { transform: none; }
    .navbar,
    .modal.show .modal-content,
    .toast.showing,
    body::before { will-change: auto; }
}

/* A device that cannot do backdrop-filter gets an opaque surface rather than
   unreadable text over the aurora. */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .navbar, .card, .modal-content, .dropdown-menu, .toast {
        background: var(--surface-solid);
    }
}
